{
  "name": "carmod",
  "productName": "carmod",
  "version": "0.1.0",
  "private": true,
  "description": "carmod — 3D 汽车改装配置客户端",
  "author": {
    "name": "lukaizj",
    "url": "https://github.com/lukaizj"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lukaizj/car-mod-saas.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/patch-next-externals.cjs",
    "start": "next start",
    "desktop:dev": "npm run build && electron desktop/main.cjs",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate dev --name init && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.carmod.app",
    "productName": "carmod",
    "asar": false,
    "files": [
      ".next/**/*",
      "public/**/*",
      "desktop/**/*",
      "assets/carmod.png",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!node_modules/electron*/**/*",
      "!node_modules/electron-builder/**/*"
    ],
    "extraResources": [
      {
        "from": "dev.db",
        "to": "dev.db",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "assets/carmod.png",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "assets/carmod.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Graphics",
      "icon": "assets",
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "better-sqlite3": "^13.0.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
