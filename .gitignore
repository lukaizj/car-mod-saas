# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local database
/dev.db

# local evaluation asset; source license must be confirmed before redistribution
/public/models/audi-rs6.web.glb

# locally uploaded shop models; retain only the empty directory marker
/public/models/uploads/*
!/public/models/uploads/.gitkeep

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local agent tooling
/.agents/
/.claude/
/.windsurf/
/skills-lock.json
